classDiagram
    class AgentApplication {
        +main(String[] args)
    }

    class AgentConfig {
        +chatMemory() ChatMemory
        +agentChatClient(builder, agentTools, documentationTools, mcpToolProvider, chatMemory) ChatClient
    }

    class McpConfig {
        +localMcpClient(enabled, url, sseEndpoint, username, password) McpSyncClient
        +parallelSearchMcpClient(enabled, url, endpoint, apiKey) McpSyncClient
        +safeInitialize(name, client) McpSyncClient
        +mcpToolProvider(mcpSyncClients) ToolCallbackProvider
    }

    class AgentController {
        +chat(request) Map
        +tools() List
    }

    class DocumentationController {
        +document() Map
    }

    class RagController {
        +ingest(request) Map
    }

    class AgentTools {
        +getCurrentDateTime() String
        +calculate(left, operator, right) double
        +getSystemInfo() String
    }

    class DocumentationTools {
        -root Path
        +scanForMissingJavadoc() String
        +readJavaFile(relativePath) String
        +writeJavaFile(relativePath, content) String
    }

    class ChatModelLoggingAspect {
        +logChatModel(joinPoint) Object
    }

    class ChatRequest {
        +message String
        +conversationId String
    }

    class IngestRequest {
        +text String
    }

    class ChatClient
    class ChatMemory
    class ToolCallbackProvider
    class VectorStore
    class McpSyncClient

    AgentApplication --> AgentConfig
    AgentApplication --> McpConfig
    AgentController --> ChatClient
    AgentController --> ToolCallbackProvider
    AgentController --> ChatRequest
    DocumentationController --> ChatClient
    RagController --> VectorStore
    RagController --> ChatClient
    RagController --> IngestRequest
    AgentConfig --> ChatMemory
    AgentConfig --> ChatClient
    AgentConfig --> AgentTools
    AgentConfig --> DocumentationTools
    AgentConfig --> ToolCallbackProvider
    McpConfig --> McpSyncClient
