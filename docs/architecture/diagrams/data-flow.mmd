flowchart LR
    client["API Client"]
    docOperator["Documentation Operator"]

    subgraph app["Spring AI Agent Application"]
        agentApi["AgentController"]
        documentationApi["DocumentationController"]
        ragApi["RagController"]
        orchestrator["ChatClient + advisors"]
        localTools["AgentTools"]
        documentationTools["DocumentationTools"]
        mcpCallbacks["MCP ToolCallbackProvider"]
        vectorStore["VectorStore"]
    end

    ollama["Ollama"]
    localMcp["Local MCP server"]
    parallelMcp["Parallel Search MCP server"]
    pgvector[("PostgreSQL + pgvector")]
    repo[("Repository .java files")]

    client -->|"POST /api/agent/chat"| agentApi
    client -->|"GET /api/agent/tools"| agentApi
    client -->|"POST /api/rag/ingest"| ragApi
    docOperator -->|"POST /api/agent/document"| documentationApi

    agentApi -->|"Prompt + conversationId"| orchestrator
    agentApi -->|"List tool definitions"| mcpCallbacks
    documentationApi -->|"Fixed documentation instruction"| orchestrator
    ragApi -->|"Document(text)"| vectorStore

    orchestrator -->|"Chat prompts / responses"| ollama
    orchestrator -->|"Invoke local tools"| localTools
    orchestrator -->|"Invoke documentation tools"| documentationTools
    orchestrator -->|"Invoke remote tools"| mcpCallbacks

    documentationTools -->|"Scan/read/write .java"| repo
    mcpCallbacks -->|"SSE + Basic auth from config"| localMcp
    mcpCallbacks -->|"Streamable HTTP + API key from config"| parallelMcp
    vectorStore -->|"Embeddings request"| ollama
    vectorStore -->|"Persist vectors"| pgvector
